{
  "name": "below-the-abbey",
  "productName": "Below the Abbey",
  "version": "0.1.0",
  "description": "Desktop wrapper for Below the Abbey",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-game": "node prepare.js",
    "dist": "node prepare.js && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.deepspace.belowtheabbey",
    "productName": "Below the Abbey",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [{ "from": "game", "to": "game" }],
    "win": { "target": ["dir", "nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
